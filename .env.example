PORT=
# Porta do websocket (padrão 8001).
SOCKET_PORT=
MONGODB_URI=
MONGO_DATABASE=
JWT_SECRET=
JSON_ENCRYPTION_KEY=
APP_URL=

SES_FROM=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_CONFIGURATION_SET=
# Sem SES_FROM, "true" registra os emails no log em vez de enviar (só dev).
MAIL_DEV_LOG=

# Atrás de proxy/load balancer (necessário para o rate limit por IP funcionar):
PROXY_HEADER=
TRUSTED_PROXIES=

# Links antigos pelo _id (só itens anteriores ao slug). Defina "false" para desligar.
LEGACY_ID_LINKS=
# Origens aceitas pelo websocket (separadas por vírgula). Padrão "*".
SOCKET_CORS_ORIGINS=
