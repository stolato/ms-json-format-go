PORT=
MONGO_URI=
MONGO_DATABASE=
JWT_SECRET=
JSON_ENCRYPTION_KEY=
APP_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Atrás de proxy/load balancer (necessário para o rate limit por IP funcionar):
PROXY_HEADER=
TRUSTED_PROXIES=
# Links antigos pelo _id (só itens anteriores ao slug). Defina "false" para desligar.
LEGACY_ID_LINKS=
# /metrics do Prometheus (padrão 127.0.0.1:9091; "off" desliga). Não publique em produção.
METRICS_ADDR=
# Origens aceitas pelo websocket (separadas por vírgula). Padrão "*".
SOCKET_CORS_ORIGINS=
